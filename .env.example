DATABASE_URL="postgresql://postgres:postgres@localhost:5432/video_replacer?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. When set, uploads go to Vercel Blob and become public URLs that Kling can fetch.
# Keep empty for local-only mock uploads.
BLOB_READ_WRITE_TOKEN=""

# mock | fal | kling
AI_PROVIDER="mock"

# Required when AI_PROVIDER="fal"
FAL_KEY=""
FAL_MODEL_ID="fal-ai/wan-vace-14b/inpainting"
FAL_ESTIMATED_DURATION_MS="240000"
FAL_RESOLUTION="auto"
FAL_VIDEO_QUALITY="high"
FAL_VIDEO_WRITE_MODE="balanced"
FAL_ENABLE_SAFETY_CHECKER="true"
FAL_ENABLE_PROMPT_EXPANSION="true"
FAL_GUIDANCE_SCALE="5"
FAL_NUM_INFERENCE_STEPS="30"
FAL_ACCELERATION="regular"

# Required when AI_PROVIDER="kling"
# 云雾中转通常使用 https://yunwu.ai + /kling/v1/videos/omni-video
KLING_API_KEY=""
KLING_BASE_URL="https://yunwu.ai"
KLING_CREATE_PATH="/kling/v1/videos/omni-video"
KLING_QUERY_PATH="/kling/v1/videos/omni-video/{task_id}"
KLING_MODEL_NAME="kling-v3-omni"
KLING_MODEL_FIELD="model_name"
KLING_MODE="pro"
KLING_DURATION=""
KLING_VIDEO_REFER_TYPE="base"
KLING_KEEP_ORIGINAL_SOUND="yes"
KLING_SOUND="off"
KLING_MAX_REFERENCE_IMAGES="4"
KLING_ESTIMATED_DURATION_MS="300000"
KLING_USE_DATA_URI="false"
KLING_WATERMARK_DISABLED="true"

# 如果你用 Vercel Blob，不需要配置 MEDIA_PUBLIC_BASE_URL；Blob 返回的就是公网 URL。
# 如果你使用其他对象存储/CDN，可以填这个并设置 KLING_USE_DATA_URI=false
MEDIA_PUBLIC_BASE_URL=""
